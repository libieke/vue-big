# just a flag
ENV = 'development'

# base api
VUE_APP_BASE_API = '/api'

# enable mock data in development
VUE_APP_MOCK = true

# Umami 访问统计（不配置则不启用）
# 埋点脚本地址：自托管一般为 http://<umami-host>/script.js，Cloud 为 https://cloud.umami.is/script.js
VUE_APP_UMAMI_SCRIPT_URL =
# 网站 ID
VUE_APP_UMAMI_WEBSITE_ID =
# 统计接口前缀：自托管走本地代理填 /umami-api/api；Umami Cloud 填 https://api.umami.is/v1
VUE_APP_UMAMI_API_BASE = /umami-api/api
# 本地代理目标（仅开发环境使用）
VUE_APP_UMAMI_API_HOST = http://localhost:3000
# 自托管账号密码（与 VUE_APP_UMAMI_TOKEN 二选一）
VUE_APP_UMAMI_USERNAME =
VUE_APP_UMAMI_PASSWORD =
# 已有长期 token 时填写
VUE_APP_UMAMI_TOKEN =
# Umami Cloud 的 API Key
VUE_APP_UMAMI_API_KEY =
