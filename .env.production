# just a flag
ENV = 'production'

# base api
VUE_APP_BASE_API = ''

# GitHub Pages is static hosting with no backend, so serve the built-in mock data
VUE_APP_MOCK = true

# Umami 访问统计（不配置则不启用）
# 注意：GitHub Pages 为纯静态托管，无法使用同源代理，以下地址必须是 HTTPS 绝对地址
# 埋点脚本地址：自托管 https://<umami-host>/script.js，Cloud https://cloud.umami.is/script.js
VUE_APP_UMAMI_SCRIPT_URL =
# 网站 ID
VUE_APP_UMAMI_WEBSITE_ID =
# 统计接口前缀：
#   自托管经 Nginx 反代填 https://<proxy-host>/umami-api/api
#   Umami Cloud 直连填 https://api.umami.is/v1
VUE_APP_UMAMI_API_BASE =
# 自托管账号密码（与 VUE_APP_UMAMI_TOKEN 二选一）
# 注意：前端打包后任何密钥都会暴露，生产环境建议由 Nginx 代理注入认证
VUE_APP_UMAMI_USERNAME =
VUE_APP_UMAMI_PASSWORD =
# 已有长期 token 时填写
VUE_APP_UMAMI_TOKEN =
# Umami Cloud 的 API Key
VUE_APP_UMAMI_API_KEY =
